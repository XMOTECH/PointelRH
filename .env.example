# ==============================================================================
# LuminaRH / PointelRH — Variables d'Environnement Globales (.env.example)
# Copiez ce fichier vers `.env` et ajustez les valeurs selon votre environnement.
# ==============================================================================

# ── Environnement Général ─────────────────────────────────────────────────────
NODE_ENV=production
APP_VERSION=1.0.0
PORT=3000

# ── Domaine & Reverse Proxy (Caddy / HTTPS) ───────────────────────────────────
DOMAIN=localhost
AUTH_DOMAIN=auth.localhost
ACME_EMAIL=admin@luminarh.sn

# ── Base de Données PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=luminarh_db
POSTGRES_USER=luminarh_user
POSTGRES_PASSWORD=change_this_postgres_password_in_production
POSTGRES_PORT=5432
# URL interne Docker utilisée par le Backend :
DATABASE_URL="postgresql://luminarh_user:change_this_postgres_password_in_production@luminarh-db:5432/luminarh_db?schema=public"

# ── Redis (Cache & Files d'attente BullMQ) ────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6380
REDIS_PASSWORD=change_this_redis_password_in_production

# ── Keycloak (Gestion des Identités & Accès - IAM) ─────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_this_keycloak_admin_password_in_production
KEYCLOAK_AUTH_SERVER_URL=http://keycloak:8080
KEYCLOAK_REALM=luminarh
KEYCLOAK_CLIENT_ID=luminarh-backend
KEYCLOAK_CLIENT_SECRET=change_this_keycloak_client_secret_in_production
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASS=change_this_keycloak_admin_password_in_production

# ── Sécurité & CORS ───────────────────────────────────────────────────────────
ALLOWED_ORIGINS="http://localhost:5180,http://localhost:3000,https://localhost"
SWAGGER_ENABLED=false

# ── Configuration SMTP Mailer ─────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=votre-email@example.com
SMTP_PASS=votre-mot-de-passe-application
SMTP_FROM="LuminaRH <votre-email@example.com>"

# ── Frontend (Injecté au Build Vite) ──────────────────────────────────────────
VITE_API_URL=""
VITE_GOOGLE_CLIENT_ID=""
VITE_KEYCLOAK_URL=http://localhost:8085
VITE_KEYCLOAK_REALM=luminarh
VITE_KEYCLOAK_CLIENT_ID=luminarh-backend
