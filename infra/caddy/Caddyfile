# ─────────────────────────────────────────────────────────────
# LuminaRH / PointelRH — Caddy Reverse Proxy Configuration
# Mode HTTP direct (compatible IP publique et localhost sans SSL)
# ─────────────────────────────────────────────────────────────
:80 {
    encode zstd gzip

    # En-têtes de sécurité
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(self), geolocation=(self), microphone=()"
        -Server
    }

    # API NestJS (Fastify)
    handle /api/* {
        reverse_proxy backend:3000
    }

    # Documentation Swagger (si activée)
    handle /docs* {
        reverse_proxy backend:3000
    }

    # Frontend SPA (Nginx)
    handle {
        reverse_proxy frontend:80
    }

    log {
        output stdout
        format json
    }
}
