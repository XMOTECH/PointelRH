# ─────────────────────────────────────────────────────────────
# LuminaRH / PointelRH — Caddy Reverse Proxy & TLS Configuration
# ─────────────────────────────────────────────────────────────
{
    email {$ACME_EMAIL:admin@luminarh.sn}
}

# ── Site Principal (Frontend & API) ──────────────────────────
# Écoute sur le domaine configuré (ex: rh.pointel.com avec SSL auto)
# ou par défaut sur le port HTTP :80 (compatible localhost et IP Azure directe)
{$DOMAIN::80} {
    encode zstd gzip

    # En-têtes de sécurité
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(self), geolocation=(self), microphone=()"
        -Server
    }

    # API NestJS (Fastify)
    handle /api/* {
        reverse_proxy backend:3000
    }

    # Documentation Swagger (si activée)
    handle /docs* {
        reverse_proxy backend:3000
    }

    # Frontend SPA (Nginx)
    handle {
        reverse_proxy frontend:80
    }

    # Journalisation d'accès au format JSON
    log {
        output stdout
        format json
    }
}

# ── Sous-domaine Keycloak IAM (si configuré) ─────────────────
{$AUTH_DOMAIN:auth.localhost} {
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        -Server
    }

    reverse_proxy keycloak:8080

    log {
        output stdout
        format json
    }
}
