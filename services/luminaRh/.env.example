# Database Connection String (expose le port 5437 sur docker-compose)
DATABASE_URL="postgresql://luminarh_user:luminarh_pass@localhost:5437/luminarh_db?schema=public"

# Configuration Redis
REDIS_HOST="localhost"

# Configuration Keycloak (mappé sur le port 8085)
KEYCLOAK_AUTH_SERVER_URL="http://localhost:8085"
KEYCLOAK_REALM="luminarh"
KEYCLOAK_CLIENT_ID="luminarh-backend"
KEYCLOAK_CLIENT_SECRET="your-client-secret-here"
KEYCLOAK_ADMIN_USER="admin"
KEYCLOAK_ADMIN_PASS="your-keycloak-admin-password"

# Configuration du port local du serveur NestJS
PORT=3000

# Origines CORS autorisées (séparées par des virgules)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Configuration SMTP Mailer
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-email@example.com"
SMTP_PASS="your-app-password"
SMTP_FROM="LuminaRH <your-email@example.com>"

