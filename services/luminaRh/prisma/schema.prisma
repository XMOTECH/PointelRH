datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "employee", "pointage", "notification", "analytics"]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

// ==========================================
// 1. MODULE: AUTH (schema: "auth")
// ==========================================

model Company {
  id        String   @id @default(uuid())
  name      String   @unique
  plan      String   @default("pro")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users          User[]
  employees      Employee[]
  departments    Department[]
  schedules      Schedule[]
  locations      Location[]
  leaveTypes     LeaveType[]
  missions       Mission[]
  dailySnapshots DailySnapshot[]

  @@map("companies")
  @@schema("auth")
}

model User {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  email        String   @unique
  password     String
  name         String
  role         String   @default("employee")
  googleId     String?  @map("google_id")
  departmentId String?  @map("department_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  employee      Employee?

  @@map("users")
  @@schema("auth")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
  @@schema("auth")
}

// ==========================================
// 2. MODULE: EMPLOYEE (schema: "employee")
// ==========================================

model Department {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]
  missions  Mission[]

  @@map("departments")
  @@schema("employee")
}

model Schedule {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name         String
  startTime    String?  @map("start_time")
  endTime      String?  @map("end_time")
  graceMinutes Int      @default(15) @map("grace_minutes")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@map("schedules")
  @@schema("employee")
}

model Employee {
  id                 String    @id @default(uuid())
  companyId          String    @map("company_id")
  userId             String    @unique @map("user_id")
  departmentId       String    @map("department_id")
  scheduleId         String?   @map("schedule_id")
  firstName          String    @map("first_name")
  lastName           String    @map("last_name")
  email              String    @unique
  pinCode            String?   @map("pin_code")
  contractType       String    @default("cdi") @map("contract_type")
  hireDate           DateTime  @default(now()) @map("hire_date")
  status             String    @default("active")
  baseSalary         Decimal   @default(0.0) @db.Decimal(12, 2) @map("base_salary")
  transportAllowance Decimal   @default(20800.0) @db.Decimal(12, 2) @map("transport_allowance")
  maritalStatus      String    @default("single") @map("marital_status")
  taxParts           Float     @default(1.0) @map("tax_parts")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  department      Department       @relation(fields: [departmentId], references: [id])
  schedule        Schedule?        @relation(fields: [scheduleId], references: [id])
  leaveRequests   LeaveRequest[]
  leaveBalances   LeaveBalance[]
  faceDescriptors FaceDescriptor[]
  shifts          Shift[]
  incidents       Incident[]
  tasks           Task[]
  assignments     MissionAssignment[]
  attendances     Attendance[]
  taskComments    TaskComment[]
  advanceRequests AdvanceRequest[]

  @@map("employees")
  @@schema("employee")
  @@index([companyId])
  @@index([departmentId])
  @@index([status])
}

model LeaveType {
  id                 String   @id @default(uuid())
  companyId          String   @map("company_id")
  name               String
  daysAllowed        Int      @map("days_allowed")
  maxDaysPerYear     Int?     @map("max_days_per_year")
  requiresAttachment Boolean  @default(false) @map("requires_attachment")
  paid               Boolean  @default(true)
  color              String   @default("#6366f1")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]

  @@map("leave_types")
  @@schema("employee")
}

model LeaveBalance {
  id          String   @id @default(uuid())
  employeeId  String   @map("employee_id")
  leaveTypeId String   @map("leave_type_id")
  balance     Decimal  @default(0.0) @db.Decimal(8, 2)
  year        Int      @default(2026)
  allocated   Decimal  @default(30.0) @db.Decimal(8, 2)
  used        Decimal  @default(0.0) @db.Decimal(8, 2)
  pending     Decimal  @default(0.0) @db.Decimal(8, 2)
  remaining   Decimal  @default(30.0) @db.Decimal(8, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId])
  @@map("leave_balances")
  @@schema("employee")
}

model LeaveRequest {
  id              String    @id @default(uuid())
  employeeId      String    @map("employee_id")
  leaveTypeId     String    @map("leave_type_id")
  startDate       DateTime  @map("start_date")
  endDate         DateTime  @map("end_date")
  reason          String?
  rejectionReason String?   @map("rejection_reason")
  status          String    @default("pending") // pending, approved, rejected, escalated
  approvedBy      String?   @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  attachmentPath  String?   @map("attachment_path")
  halfDay         Boolean   @default(false) @map("half_day")
  halfDayPeriod   String?   @map("half_day_period") // morning, afternoon
  daysCount       Float?    @map("days_count")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@map("leave_requests")
  @@schema("employee")
  @@index([employeeId])
  @@index([status])
  @@index([startDate])
}

model Location {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  address   String?
  latitude  Float
  longitude Float
  radius    Float    @default(100.0) // en mètres
  qrToken   String?  @map("qr_token")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@map("locations")
  @@schema("employee")
}

model Shift {
  id         String   @id @default(uuid())
  employeeId String   @map("employee_id")
  date       DateTime
  startTime  String   @map("start_time")
  endTime    String   @map("end_time")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("shifts")
  @@schema("employee")
  @@index([employeeId, date])
}

model AdvanceRequest {
  id         String   @id @default(uuid())
  employeeId String   @map("employee_id")
  amount     Decimal  @db.Decimal(12, 2)
  type       String   @default("advance") // advance (acompte), loan (prêt)
  reason     String?
  status     String   @default("pending") // pending, approved, rejected
  repaid     Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("advance_requests")
  @@schema("employee")
  @@index([employeeId])
  @@index([status])
}

model Incident {
  id          String   @id @default(uuid())
  employeeId  String   @map("employee_id")
  type        String
  description String
  date        DateTime
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("incidents")
  @@schema("employee")
}

model Mission {
  id           String              @id @default(uuid())
  companyId    String              @map("company_id")
  title        String
  description  String?
  location     String?
  startDate    DateTime            @map("start_date")
  endDate      DateTime?           @map("end_date")
  status       String              @default("draft") // draft, active, completed, cancelled
  departmentId String?             @map("department_id")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department   Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignments  MissionAssignment[]
  tasks        Task[]
  documents    MissionDocument[]

  @@map("missions")
  @@schema("employee")
}

model MissionDocument {
  id             String   @id @default(uuid())
  missionId      String   @map("mission_id")
  fileName       String   @map("file_name")
  fileType       String   @map("file_type") // image, pdf, video, document
  fileSize       Int      @map("file_size")
  url            String
  uploadedByName String?  @map("uploaded_by_name")
  createdAt      DateTime @default(now()) @map("created_at")

  mission        Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@map("mission_documents")
  @@schema("employee")
}

model MissionAssignment {
  id         String   @id @default(uuid())
  missionId  String   @map("mission_id")
  employeeId String   @map("employee_id")
  createdAt  DateTime @default(now()) @map("created_at")

  mission  Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([missionId, employeeId])
  @@map("mission_assignments")
  @@schema("employee")
}

model Task {
  id               String    @id @default(uuid())
  missionId        String?   @map("mission_id")
  employeeId       String?   @map("employee_id")
  title            String
  description      String?
  priority         String    @default("medium") // low, medium, high
  status           String    @default("todo") // todo, in_progress, done
  dueDate          DateTime? @map("due_date")
  recurrence       String?   // daily, weekly, null
  estimatedMinutes Int?      @map("estimated_minutes")
  actualMinutes    Int       @default(0) @map("actual_minutes")
  completedAt      DateTime? @map("completed_at")
  createdBy        String?   @map("created_by")
  departmentId     String?   @map("department_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  mission     Mission?         @relation(fields: [missionId], references: [id], onDelete: Cascade)
  employee    Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  comments    TaskComment[]
  attachments TaskAttachment[]

  @@map("tasks")
  @@schema("employee")
}

model TaskComment {
  id             String           @id @default(uuid())
  taskId         String           @map("task_id")
  employeeId     String?          @map("employee_id")
  content        String
  attachmentPath String?          @map("attachment_path")
  createdAt      DateTime         @default(now()) @map("created_at")

  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee    Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  attachments TaskAttachment[]

  @@map("task_comments")
  @@schema("employee")
}

model TaskAttachment {
  id        String   @id @default(uuid())
  commentId String?  @map("comment_id")
  taskId    String?  @map("task_id")
  fileName  String   @map("file_name")
  fileType  String   @map("file_type") // image, pdf, video, document
  fileSize  Int      @map("file_size")
  url       String
  createdAt DateTime @default(now()) @map("created_at")

  comment TaskComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  task    Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_attachments")
  @@schema("employee")
}

model FaceDescriptor {
  id         String   @id @default(uuid())
  employeeId String   @map("employee_id")
  descriptor String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("face_descriptors")
  @@schema("employee")
}

// ==========================================
// 3. MODULE: POINTAGE (schema: "pointage")
// ==========================================

model Attendance {
  id           String    @id @default(uuid())
  employeeId   String    @map("employee_id")
  locationId   String?   @map("location_id")
  clockIn      DateTime  @map("clock_in")
  clockOut     DateTime? @map("clock_out")
  deviceType   String    @default("web") @map("device_type") // web, mobile, kiosk
  ipAddress    String?   @map("ip_address")
  latitude     Float?
  longitude    Float?
  isLate       Boolean   @default(false) @map("is_late")
  lateMinutes  Int       @default(0) @map("late_minutes")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@map("attendances")
  @@schema("pointage")
  @@index([employeeId, clockIn])
  @@index([clockIn])
  @@index([isLate])
}

// ==========================================
// 4. MODULE: NOTIFICATION (schema: "notification")
// ==========================================

model Notification {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  title      String
  message    String
  type       String   @default("info")
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("notifications")
  @@schema("notification")
}

model NotificationPreference {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  email     Boolean  @default(true)
  sms       Boolean  @default(false)
  push      Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notification_preferences")
  @@schema("notification")
}

// ==========================================
// 5. MODULE: ANALYTICS (schema: "analytics")
// ==========================================

model DailySnapshot {
  id             String   @id @default(uuid())
  companyId      String   @map("company_id")
  date           DateTime
  totalEmployees Int      @map("total_employees")
  presentCount   Int      @map("present_count")
  lateCount      Int      @map("late_count")
  absentCount    Int      @map("absent_count")
  createdAt      DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@map("daily_snapshots")
  @@schema("analytics")
}

model EmployeeMonthlyStat {
  id             String   @id @default(uuid())
  employeeId     String   @map("employee_id")
  monthYear      String   @map("month_year") // ex: "06-2026"
  daysPresent    Int      @default(0) @map("days_present")
  daysLate       Int      @default(0) @map("days_late")
  daysAbsent     Int      @default(0) @map("days_absent")
  overtimeMinutes Int      @default(0) @map("overtime_minutes")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([employeeId, monthYear])
  @@map("employee_monthly_stats")
  @@schema("analytics")
}
